QLOO_API_SERVER_URL=https://hackathon.api.qloo.com
QLOO_API_KEY=
# Optional: enables the Claude-written concepts and the LLM-only comparison
ANTHROPIC_API_KEY=
# Optional: generated hero images (off by default; posters use Qloo imagery)
OPENAI_API_KEY=
GENERATE_IMAGES=0
# Optional operations (see backend/app/ops.py and backend/app/backup.py)
# ADMIN_TOKEN enables the /ops view; OPS_SLACK_WEBHOOK gets spend alerts
ADMIN_TOKEN=
OPS_SLACK_WEBHOOK=
# A daily snapshot of all data goes here (a mounted volume keeps it off the server)
BACKUP_DIR=
BACKUP_KEEP=14
# Local development only: lift the per-IP rate limits while testing (never on a public server)
RATE_LIMITS=on
